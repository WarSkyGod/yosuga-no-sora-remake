// Package launcher: tvpwin32.exe loads the shared data runtime.
var YOSUGA_NATIVE_INFORM = System.inform;
var YOSUGA_INFORM_ACTIVE = false;
System.inform = function(msg)
{
	Debug.message("!!! INFORM: " + msg);
	if(YOSUGA_INFORM_ACTIVE) return;
	YOSUGA_INFORM_ACTIVE = true;
	try{ YOSUGA_NATIVE_INFORM(msg); }
	catch(e){ Debug.message("System.inform failed: " + e); }
	YOSUGA_INFORM_ACTIVE = false;
};

Storages.addAutoPath("data/");
Scripts.execStorage("k2compat.tjs");
Debug.message("=== yosuga_krkrZ package startup ===");

var contentDataPaths = [
    "data/system/",
    "data/scenario/",
    "data/bg_1920/",
    "data/event_1920/",
    "data/character_1920/",
    "data/char/",
    "data/audio_ogg/",
    "data/font/",
    "data/frame/",
    "data/frame_m2/",
    "data/rule/",
    "data/thumb/",
    "data/ui_1920/"
];
for(var i = 0; i < contentDataPaths.count; i++)
    Storages.addAutoPath(contentDataPaths[i]);
invalidate contentDataPaths;
Debug.message("Auto-paths: shared data runtime paths registered");

Scripts.execStorage("Status.tjs");
Debug.message("startup.tjs: Status.tjs loaded");
Scripts.execStorage("Initialize.tjs");
Debug.message("startup.tjs: Initialize.tjs loaded");
Scripts.execStorage("begin.tjs");
Debug.message("startup.tjs: begin.tjs loaded");
